{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPACT — Affirmation documentée",
  "description": "Structure d'une affirmation éditoriale vérifiable. Les identifiants et exemples sont fictifs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject_entity_id",
    "statement",
    "topic",
    "claim_status",
    "source_ids",
    "reviewed_at",
    "uncertainty_note"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "subject_entity_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "topic": {
      "type": "string",
      "enum": [
        "animals_food",
        "environment",
        "human_rights",
        "business_consumption",
        "technology_privacy",
        "other"
      ]
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "corroborated",
        "alleged",
        "disputed",
        "refuted",
        "insufficient_information",
        "not_reviewed"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      },
      "uniqueItems": true,
      "default": []
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "uncertainty_note": {
      "type": "string",
      "maxLength": 2000
    },
    "editorial_note": {
      "type": "string",
      "maxLength": 3000
    },
    "publication_basis": {
      "type": "string",
      "enum": [
        "evidence_verified"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date"
    },
    "publication_note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "requires_human_review": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_basis": {
            "const": "evidence_verified"
          }
        },
        "required": [
          "publication_basis"
        ]
      },
      "then": {
        "required": [
          "published_at",
          "publication_note"
        ],
        "properties": {
          "published_at": {
            "type": "string",
            "format": "date"
          },
          "publication_note": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        }
      }
    }
  ]
}
