{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPACT — Relation entre entités",
  "description": "Relation qualifiée et sourcée entre deux entités. Une relation commerciale ne prouve pas une relation de propriété.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from_entity_id", "to_entity_id", "relationship_type", "knowledge_status", "source_ids"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "from_entity_id": { "type": "string", "minLength": 3, "maxLength": 80 },
    "to_entity_id": { "type": "string", "minLength": 3, "maxLength": 80 },
    "relationship_type": {
      "type": "string",
      "enum": ["owns", "operates", "manufactures", "distributes", "supplies", "certifies", "funds", "partners_with", "alternative_to", "other"]
    },
    "knowledge_status": { "type": "string", "enum": ["confirmed", "partial", "disputed", "unknown"] },
    "valid_from": { "type": ["string", "null"], "format": "date" },
    "valid_until": { "type": ["string", "null"], "format": "date" },
    "source_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 3, "maxLength": 80 },
      "uniqueItems": true,
      "minItems": 1
    },
    "notes": { "type": "string", "maxLength": 3000 }
  }
}
