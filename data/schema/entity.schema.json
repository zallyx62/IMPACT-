{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPACT — Entité",
  "description": "Organisation, marque, produit ou service identifié. Les exemples et identifiants doivent être vérifiés avant publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "entity_type",
    "status",
    "reviewed_at",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "organization",
        "brand",
        "product",
        "service",
        "association",
        "institution",
        "public_body"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "website": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2000
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "country_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "review_needed",
        "withdrawn"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "publication_basis": {
      "type": "string",
      "enum": [
        "evidence_verified"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date"
    },
    "publication_note": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_basis": {
            "const": "evidence_verified"
          }
        },
        "required": [
          "publication_basis"
        ]
      },
      "then": {
        "required": [
          "published_at",
          "publication_note"
        ],
        "properties": {
          "published_at": {
            "type": "string",
            "format": "date"
          },
          "publication_note": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        }
      }
    }
  ]
}
