{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPACT — Entité",
  "description": "Organisation, marque, produit ou service identifié. Les exemples et identifiants doivent être vérifiés avant publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "entity_type", "status", "reviewed_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 300 },
    "entity_type": {
      "type": "string",
      "enum": ["organization", "brand", "product", "service", "association", "institution", "public_body"]
    },
    "description": { "type": "string", "maxLength": 3000 },
    "website": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 },
    "country_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "uniqueItems": true,
      "default": []
    },
    "status": { "type": "string", "enum": ["draft", "published", "review_needed", "withdrawn"] },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "reviewed_at": { "type": "string", "format": "date" }
  }
}
