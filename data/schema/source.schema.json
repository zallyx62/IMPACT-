{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impact.example/schema/source.schema.json",
  "title": "IMPACT — Source",
  "description": "Référence bibliographique ou documentaire consultée pour étayer ou contester une affirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "source_type",
    "accessed_at",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "publisher": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_document",
        "official_statement",
        "scientific_study",
        "academic_review",
        "court_or_regulatory_decision",
        "ngo_report",
        "journalism",
        "database",
        "other"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "methodology": {
      "type": "string",
      "maxLength": 3000
    },
    "potential_conflicts": {
      "type": "string",
      "maxLength": 2000
    },
    "limitations": {
      "type": "string",
      "maxLength": 3000
    },
    "archived_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2000
    },
    "review_status": {
      "type": "string",
      "enum": [
        "to_review",
        "reviewed",
        "disputed",
        "unavailable"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "url"
        ]
      },
      "then": {
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  ]
}
