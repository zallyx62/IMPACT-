{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPACT — Élément de preuve",
  "description": "Localisateur et synthèse d'un élément précis provenant d'une source identifiée.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_id", "locator", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "source_id": { "type": "string", "minLength": 3, "maxLength": 80 },
    "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
    "excerpt": { "type": "string", "maxLength": 1200 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "supports_claim_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 3, "maxLength": 80 },
      "uniqueItems": true,
      "default": []
    },
    "contradicts_claim_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 3, "maxLength": 80 },
      "uniqueItems": true,
      "default": []
    },
    "limitations": { "type": "string", "maxLength": 2000 }
  }
}
